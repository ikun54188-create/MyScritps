local function infAmmo()
    local tool = game:GetService("Players").LocalPlayer.Character

    local hook
    hook = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        if self == tool and method == "GetAttribute" and args[1] == "Reloading" and getgenv().INF_AMMO then
            return false
        end
        return hook(self, ...)
    end))

    player.CharacterAdded:Connect(function(character)
        wait(1)
        tool = character
    end)

    while getgenv().INF_AMMO do
        wait()
        task.spawn(function()
            local args = {
                game:GetService("Players").LocalPlayer.Character:WaitForChild("Deagle")
            }
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Reload"):InvokeServer(unpack(args))
        end)
    end
end

