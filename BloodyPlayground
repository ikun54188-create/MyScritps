local function canGrabWhenFlying()
    local hook
    hook = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if tostring(self) == "Humanoid" and key == "PlatformStand" and getgenv().CanGrabWhenFlying then
            return false
        end
        return hook(self, key)
    end))
end

