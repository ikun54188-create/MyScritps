--Infect Aura

function InfectAura()
    RunService.Heartbeat:Connect(function(deltaTime)
        if InfectAuraToggle == false then return end
        local Infected = game:GetService("Players").LocalPlayer.Character:FindFirstChild("Infected")

        if Infected then
            local InfectEvent = game:GetService("Players").LocalPlayer.Character.Infected.InfectEvent
            InfectEvent:FireServer("S")
        else
            print("Player isnt Smiler")
        end
    end)
end

--Swing Aura
function SwingAura()
    RunService.Heartbeat:Connect(function(deltaTime)
        if SwingAuraToggle == false then return end
        local Weapon = Character:FindFirstChildOfClass("Tool")

        if not Weapon then return end
        local SwingEvent = Weapon.SwingEvent
        SwingEvent:FireServer()
    end)
end

--AntiSpear
function AntiSpear()
    local MainSpear = workspace.Map.Misc:WaitForChild("Spearer")
    if AntiSpearToggle == true then
        for _,v in pairs(MainSpear:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanTouch = false         
            end
        end
    else
        for _,v in pairs(MainSpear:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanTouch = true         
            end
        end
    end
end

