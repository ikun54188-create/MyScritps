--Find key
function FindKey()
    local FoundKey = false
    for i,v in pairs(Players:GetPlayers()) do
        if v == LocalPlayer then return end
        local GreenKey = v.Backpack:FindFirstChild("Green Key") or v.Character:FindFirstChild("Green Key")
        local RedKey = v.Backpack:FindFirstChild("Red Key") or v.Character:FindFirstChild("Red Key")
        local WhiteKey = v.Backpack:FindFirstChild("White Key") or v.Character:FindFirstChild("White Key")
        if GreenKey or RedKey or WhiteKey then
            local Key = GreenKey or RedKey or WhiteKey
            FoundKey = true
            Rayfield:Notify({
                Title = "Found a "..Key.Name,
                Content = v.Name.."Has Key",
                Duration = 6.5,
                Image = Players:GetUserThumbnailAsync(v.UserId),
            })
        else
            Rayfield:Notify({
                Title = "Not found key",
                Content = "No one has key",
                Duration = 6.5,
                Image = 4483362458,
            })
        end
    end
end

function AutoPickCoins()
    RunService.Heartbeat:Connect(function(deltaTime)
        if AutoPickCoinsToggle == false then return end
        for i, v in pairs(coins) do
            firetouchinterest(game.Players.LocalPlayer.Character.HumanoidRootPart, v, false)
            table.remove(coins, i)
        end
    end)

    while wait(1) do
        for i, v in pairs(workspace:GetDescendants()) do
            if v.Name == "SmileCoin" then
                table.insert(coins, v)
            end
        end
    end
end

